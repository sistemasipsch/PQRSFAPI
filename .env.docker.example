# ============================================================================
# Variables del despliegue con Docker en el VPS.
# En el VPS:  cp .env.docker.example .env   y completar los valores.
# El .env NO se sube al repositorio.
# ============================================================================

# ---------------------------------------------------------------- Dominios (OBLIGATORIO)
# Subdominio del backend; su registro DNS (A) debe apuntar a la IP del VPS.
API_DOMAIN=api-correspondencia.clinicalhouse.co
# Dominio donde está publicado el frontend en Hostinger (sin barra final; varios separados por coma)
CORS_ORIGINS=https://correspondencia.clinicalhouse.co
# URL pública del frontend (logo y enlaces en los correos)
APP_PUBLIC_URL=https://correspondencia.clinicalhouse.co

# ---------------------------------------------------------------- Base de datos (OBLIGATORIO)
# La crea el contenedor de PostgreSQL la primera vez con estos datos.
DB_USER=pqrsf
DB_PASSWORD=

# ---------------------------------------------------------------- Sesiones (OBLIGATORIO)
# Texto largo y aleatorio (mínimo 64 caracteres). En Linux:  openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------- Correo (Gmail)
MAIL_USERNAME=notificacioneschpqrs@gmail.com
MAIL_PASSWORD=
MAIL_FROM=notificacioneschpqrs@gmail.com
MAIL_JEFE=siau@clinicalhouse.co

# ---------------------------------------------------------------- Cuentas iniciales (solo base de datos nueva)
# Vacías = contraseña aleatoria que aparece UNA vez en:  docker compose logs backend
ADMIN_PASSWORD_INICIAL=
JEFE_PASSWORD_INICIAL=
