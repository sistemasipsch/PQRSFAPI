# Copie este archivo como .env (en la carpeta desde donde se ejecuta el backend) y complete los valores.
# El archivo .env NO se sube al repositorio. En un servidor también puede definir estas variables
# como variables de entorno del sistema o del servicio (tienen prioridad sobre el .env).

# ---------------------------------------------------------------- Base de datos (OBLIGATORIO)
DB_URL=jdbc:postgresql://localhost:5432/pqrsf-siau
DB_USER=postgres
DB_PASSWORD=

# ---------------------------------------------------------------- Sesiones (OBLIGATORIO)
# Texto largo y aleatorio (mínimo 64 caracteres). Generarlo, por ejemplo, en PowerShell con:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Si se cambia, todos los funcionarios deben iniciar sesión de nuevo.
JWT_SECRET=

# ---------------------------------------------------------------- Correo (Gmail)
# Cuenta que envía los correos y su contraseña de aplicación (16 letras, sin espacios):
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=notificacioneschpqrs@gmail.com
MAIL_PASSWORD=
MAIL_FROM=notificacioneschpqrs@gmail.com
# Destino de las notificaciones de solicitudes nuevas (Jefe SIAU)
MAIL_JEFE=siau@clinicalhouse.co

# ---------------------------------------------------------------- Dominio público
# URL donde se abre el sistema (enlaces y logo en los correos)
APP_PUBLIC_URL=https://pqrsf.clinicalhouse.co
# Dominios desde los que se usa el panel, separados por coma (sin barra final)
CORS_ORIGINS=https://pqrsf.clinicalhouse.co

# ---------------------------------------------------------------- Cuentas iniciales (solo base de datos nueva)
# Si se dejan vacías, se genera una contraseña aleatoria que aparece UNA vez en el registro del servidor.
ADMIN_PASSWORD_INICIAL=
JEFE_PASSWORD_INICIAL=

# ---------------------------------------------------------------- Opcionales
# SERVER_PORT=8080
# UPLOAD_DIR=uploads
# LOG_FILE=logs/backend.log
